// Custom configuration for nf-core/fastquorum pipeline
// Set maximum memory to 1.8GB for all processes

process {
    memory = '1.8 GB'
    cpus = 1
    
    withName: 'NFCORE_FASTQUORUM:FASTQUORUM:FASTQTOBAM' {
        memory = '1.8 GB'
        cpus = 1
    }
    
    withName: 'NFCORE_FASTQUORUM:FASTQUORUM:GROUPREADSBYUMI' {
        memory = '1.8 GB'
        cpus = 1
    }
    
    withName: 'NFCORE_FASTQUORUM:FASTQUORUM:COLLECTDUPLEXSEQMETRICS' {
        memory = '1.8 GB'
        cpus = 1
    }
    
    withName: 'NFCORE_FASTQUORUM:FASTQUORUM:CALLDDUPLEXCONSENSUSREADS' {
        memory = '1.8 GB'
        cpus = 1
    }
    
    withName: 'NFCORE_FASTQUORUM:FASTQUORUM:ALIGN_CONSENSUS_BAM' {
        memory = '1.8 GB'
        cpus = 1
    }
    
    withName: 'NFCORE_FASTQUORUM:FASTQUORUM:FILTERCONSENSUSREADS' {
        memory = '1.8 GB'
        cpus = 1
    }
    
    withName: 'NFCORE_FASTQUORUM:FASTQUORUM:MULTIQC' {
        memory = '1.8 GB'
        cpus = 1
    }
    
    withName: 'NFCORE_FASTQUORUM:FASTQUORUM:FASTQC' {
        memory = '1.8 GB'
        cpus = 1
    }
    
    // PREPARE_GENOME processes
    withName: 'NFCORE_FASTQUORUM:PREPARE_GENOME:BWAMEM1_INDEX' {
        memory = '1.8 GB'
        cpus = 1
    }
    
    withName: 'NFCORE_FASTQUORUM:PREPARE_GENOME:SAMTOOLS_FAIDX' {
        memory = '1.8 GB'
        cpus = 1
    }
    
    withName: 'NFCORE_FASTQUORUM:PREPARE_GENOME:SAMTOOLS_DICT' {
        memory = '1.8 GB'
        cpus = 1
    }
    
    // ALIGNMENT processes
    withName: 'NFCORE_FASTQUORUM:ALIGNMENT:BWAMEM1' {
        memory = '1.8 GB'
        cpus = 1
    }
    
    withName: 'NFCORE_FASTQUORUM:ALIGNMENT:SAMTOOLS_SORT' {
        memory = '1.8 GB'
        cpus = 1
    }
    
    withName: 'NFCORE_FASTQUORUM:ALIGNMENT:SAMTOOLS_INDEX' {
        memory = '1.8 GB'
        cpus = 1
    }
    
    // Any other process that might be used
    withName: '.*' {
        memory = '1.8 GB'
        cpus = 1
    }
}

params {
  customUUID = java.util.UUID.randomUUID().toString()
}

env {
  TRACER_TRACE_ID = "${params.customUUID}"
}
