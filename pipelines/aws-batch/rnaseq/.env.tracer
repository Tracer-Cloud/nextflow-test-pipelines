# Tracer AWS Account Configuration
# Copy this file to .env if you have access to the Tracer AWS account

# AWS Configuration
AWS_PROFILE=tracer
AWS_DEFAULT_REGION=us-east-1

# Tracer-specific bucket names
WORK_BUCKET_NAME=tracer-nxf-work
OUTPUTS_BUCKET_NAME=tracer-nxf-outputs
ENVIRONMENT_NAME=rnaseq
BUCKET_SUFFIX=tracer

# Infrastructure settings
CREATE_INSTANCE_CONNECT_ENDPOINT=false

# Pipeline configuration
PROFILE=test
PIPELINE_URL=https://github.com/nf-core/rnaseq
PIPELINE_VERSION=3.20.0

# Optional: Override default instance types for Tracer account
# INSTANCE_TYPES=m5.large,m5.xlarge,m5.2xlarge
# MAX_VCPUS=512
